generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["paustik_marketplace"]
}

enum UserRole {
  CUSTOMER
  MOTHER
  DELIVERY_AGENT
  ADMIN

  @@schema("paustik_marketplace")
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED

  @@schema("paustik_marketplace")
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED

  @@schema("paustik_marketplace")
}

enum MealCadence {
  DAILY
  WEEKLY
  MONTHLY

  @@schema("paustik_marketplace")
}

enum MealCategory {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN

  @@schema("paustik_marketplace")
}

enum MealTier {
  BASE
  EGG
  CHEESE
  CHICKEN

  @@schema("paustik_marketplace")
}

enum WalletEntryDirection {
  CREDIT
  DEBIT

  @@schema("paustik_marketplace")
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED

  @@schema("paustik_marketplace")
}

enum OrderStatus {
  ORDER_PLACED
  CONFIRMED
  ASSIGNED_TO_MOTHER
  PREPARING
  READY_FOR_PICKUP
  DELIVERY_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED

  @@schema("paustik_marketplace")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@schema("paustik_marketplace")
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  GOING_TO_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED

  @@schema("paustik_marketplace")
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED

  @@schema("paustik_marketplace")
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
  CANCELLED

  @@schema("paustik_marketplace")
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  REJECTED

  @@schema("paustik_marketplace")
}

enum QualityCheckStatus {
  PASS
  NEEDS_ACTION
  FAIL

  @@schema("paustik_marketplace")
}

enum MenuCycleStatus {
  DRAFT
  PUBLISHED
  CLOSED

  @@schema("paustik_marketplace")
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("paustik_marketplace")
}

enum PaymentCategory {
  CUSTOMER_CHARGE
  MOTHER_EARNING
  DELIVERY_EARNING
  PLATFORM_FEE
  DELIVERY_FEE
  TAX
  REFUND
  ADJUSTMENT

  @@schema("paustik_marketplace")
}

model User {
  id                   String                   @id @default(uuid()) @db.Uuid
  name                 String
  email                String                   @unique
  username             String?                  @unique
  phone                String?                  @unique
  passwordHash         String                   @map("password_hash")
  role                 UserRole
  status               AccountStatus            @default(PENDING)
  emailVerifiedAt      DateTime?                @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt          DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  customerProfile      CustomerProfile?
  motherProfile        MotherProfile?
  deliveryAgentProfile DeliveryAgentProfile?
  addresses            Address[]
  authSessions         AuthSession[]
  subscriptions        Subscription[]
  walletEntries        WalletLedgerEntry[]
  favoriteKitchens     FavoriteKitchen[]
  customerOrders       Order[]                  @relation("CustomerOrders")
  ratingsGiven         Rating[]                 @relation("RatingsGiven")
  ratingsReceived      Rating[]                 @relation("RatingsReceived")
  complaints           Complaint[]
  notifications        Notification[]
  earnings             Earning[]
  payouts              Payout[]
  adminActions         AdminActivityLog[]       @relation("AdminActor")
  emailTokens          EmailVerificationToken[]
  resetTokens          PasswordResetToken[]
  cancellationRequests CancellationRequest[]
  mealChangeRequests   MealChangeRequest[]
  qualityInspections   QualityCheck[]           @relation("QualityInspector")
  orderEvents          OrderEvent[]             @relation("OrderEventActor")

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
  @@schema("paustik_marketplace")
}

model CustomerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  dietaryNotes      String?  @map("dietary_notes")
  notificationOptIn Boolean  @default(true) @map("notification_opt_in")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
  @@schema("paustik_marketplace")
}

model MotherProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  cuisine            String
  foodSafetyNotes    String?            @map("food_safety_notes")
  fssaiNumber        String?            @map("fssai_number")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rating             Decimal            @default(0) @db.Decimal(3, 2)
  qualityScore       Decimal            @default(0) @map("quality_score") @db.Decimal(5, 2)
  approvedAt         DateTime?          @map("approved_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kitchen            Kitchen?
  orders             Order[]
  earnings           Earning[]
  qualityChecks      QualityCheck[]

  @@index([verificationStatus])
  @@map("mother_profiles")
  @@schema("paustik_marketplace")
}

model DeliveryAgentProfile {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @unique @map("user_id") @db.Uuid
  vehicleType         String             @map("vehicle_type")
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  rating              Decimal            @default(0) @db.Decimal(3, 2)
  completedDeliveries Int                @default(0) @map("completed_deliveries")
  approvedAt          DateTime?          @map("approved_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries          Delivery[]
  earnings            Earning[]

  @@index([verificationStatus])
  @@map("delivery_agent_profiles")
  @@schema("paustik_marketplace")
}

model Address {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String   @default("Home")
  recipientName String   @map("recipient_name")
  phone         String
  addressLine1  String   @map("address_line_1")
  addressLine2  String?  @map("address_line_2")
  locality      String
  city          String
  pinCode       String   @map("pin_code")
  latitude      Decimal? @db.Decimal(10, 7)
  longitude     Decimal? @db.Decimal(10, 7)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]

  @@index([userId, isDefault])
  @@map("addresses")
  @@schema("paustik_marketplace")
}

model Kitchen {
  id                      String             @id @default(uuid()) @db.Uuid
  motherId                String             @unique @map("mother_id") @db.Uuid
  name                    String
  addressLine1            String             @map("address_line_1")
  locality                String
  city                    String
  pinCode                 String             @map("pin_code")
  latitude                Decimal?           @db.Decimal(10, 7)
  longitude               Decimal?           @db.Decimal(10, 7)
  serviceRadiusMeters     Int?               @map("service_radius_meters")
  marketplaceRadiusMeters Int                @default(8000) @map("marketplace_radius_meters")
  cuisine                 String
  capacityPerDay          Int                @default(0) @map("capacity_per_day")
  availableDays           String[]           @default([]) @map("available_days")
  operatingHours          Json?              @map("operating_hours")
  verificationStatus      VerificationStatus @default(PENDING) @map("verification_status")
  isAcceptingOrders       Boolean            @default(false) @map("is_accepting_orders")
  lastInspectionAt        DateTime?          @map("last_inspection_at") @db.Timestamptz(6)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  mother                  MotherProfile      @relation(fields: [motherId], references: [id], onDelete: Cascade)
  meals                   Meal[]
  menus                   Menu[]
  menuCycles              MenuCycle[]
  subscriptions           Subscription[]
  favoritedBy             FavoriteKitchen[]
  orders                  Order[]
  qualityChecks           QualityCheck[]

  @@index([city, pinCode, verificationStatus])
  @@map("kitchens")
  @@schema("paustik_marketplace")
}

model MealPlan {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  cadence       MealCadence
  mealCount     Int                @map("meal_count")
  price         Decimal            @db.Decimal(12, 2)
  currency      String             @default("INR") @db.Char(3)
  isActive      Boolean            @default(true) @map("is_active")
  policyId      String?            @map("policy_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  subscriptions Subscription[]
  policy        MarketplacePolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)

  @@map("meal_plans")
  @@schema("paustik_marketplace")
}

model FavoriteKitchen {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  kitchenId  String   @map("kitchen_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  kitchen    Kitchen  @relation(fields: [kitchenId], references: [id], onDelete: Cascade)

  @@unique([customerId, kitchenId])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("favorite_kitchens")
  @@schema("paustik_marketplace")
}

model Meal {
  id                 String              @id @default(uuid()) @db.Uuid
  kitchenId          String              @map("kitchen_id") @db.Uuid
  name               String
  description        String?
  category           MealCategory
  tier               MealTier            @default(BASE)
  components         String[]            @default([])
  cuisine            String
  ingredients        String[]            @default([])
  allergens          String[]            @default([])
  price              Decimal             @db.Decimal(12, 2)
  imageUrl           String?             @map("image_url")
  isAvailable        Boolean             @default(true) @map("is_available")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  kitchen            Kitchen             @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  menus              Menu[]
  orderItems         OrderItem[]
  ratings            Rating[]
  changeRequestsFrom MealChangeRequest[] @relation("MealChangeFrom")
  changeRequestsTo   MealChangeRequest[] @relation("MealChangeTo")

  @@index([kitchenId, isAvailable, category])
  @@map("meals")
  @@schema("paustik_marketplace")
}

model Menu {
  id           String    @id @default(uuid()) @db.Uuid
  cycleId      String    @map("cycle_id") @db.Uuid
  kitchenId    String    @map("kitchen_id") @db.Uuid
  mealId       String    @map("meal_id") @db.Uuid
  serviceDate  DateTime  @map("service_date") @db.Date
  mealPeriod   String    @default("LUNCH") @map("meal_period")
  deliveryTime String    @default("12:30") @map("delivery_time") @db.VarChar(5)
  stockCount   Int       @default(0) @map("stock_count")
  isAvailable  Boolean   @default(true) @map("is_available")
  kitchen      Kitchen   @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  cycle        MenuCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  meal         Meal      @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@unique([kitchenId, mealId, serviceDate, mealPeriod])
  @@index([serviceDate, isAvailable])
  @@map("menus")
  @@schema("paustik_marketplace")
}

model MenuCycle {
  id          String          @id @default(uuid()) @db.Uuid
  kitchenId   String          @map("kitchen_id") @db.Uuid
  name        String
  startsOn    DateTime        @map("starts_on") @db.Date
  endsOn      DateTime        @map("ends_on") @db.Date
  status      MenuCycleStatus @default(DRAFT)
  publishedAt DateTime?       @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  kitchen     Kitchen         @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  menus       Menu[]

  @@unique([kitchenId, startsOn, endsOn])
  @@index([kitchenId, status, startsOn])
  @@map("menu_cycles")
  @@schema("paustik_marketplace")
}

model Subscription {
  id                       String                @id @default(uuid()) @db.Uuid
  customerId               String                @map("customer_id") @db.Uuid
  mealPlanId               String                @map("meal_plan_id") @db.Uuid
  kitchenId                String?               @map("kitchen_id") @db.Uuid
  weeklyDays               String[]              @default([]) @map("weekly_days")
  cancellationCutoffHours  Int                   @default(5) @map("cancellation_cutoff_hours")
  cancellationOperationFee Decimal               @default(5) @map("cancellation_operation_fee") @db.Decimal(12, 2)
  status                   SubscriptionStatus    @default(ACTIVE)
  startsAt                 DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt                   DateTime?             @map("ends_at") @db.Timestamptz(6)
  nextRenewalAt            DateTime?             @map("next_renewal_at") @db.Timestamptz(6)
  preferences              Json?
  policySnapshot           Json?                 @map("policy_snapshot")
  cancelledAt              DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  createdAt                DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer                 User                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  mealPlan                 MealPlan              @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)
  kitchen                  Kitchen?              @relation(fields: [kitchenId], references: [id], onDelete: SetNull)
  orders                   Order[]
  cancellationRequests     CancellationRequest[]
  walletEntries            WalletLedgerEntry[]

  @@index([customerId, status])
  @@index([status, nextRenewalAt])
  @@map("subscriptions")
  @@schema("paustik_marketplace")
}

model Order {
  id                   String                @id @default(uuid()) @db.Uuid
  orderNumber          String                @unique @map("order_number")
  customerId           String                @map("customer_id") @db.Uuid
  motherId             String                @map("mother_id") @db.Uuid
  kitchenId            String                @map("kitchen_id") @db.Uuid
  addressId            String                @map("address_id") @db.Uuid
  subscriptionId       String?               @map("subscription_id") @db.Uuid
  status               OrderStatus           @default(ORDER_PLACED)
  paymentStatus        PaymentStatus         @default(PENDING) @map("payment_status")
  orderedAt            DateTime              @default(now()) @map("ordered_at") @db.Timestamptz(6)
  scheduledFor         DateTime              @map("scheduled_for") @db.Timestamptz(6)
  subtotal             Decimal               @db.Decimal(12, 2)
  deliveryFee          Decimal               @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  taxAmount            Decimal               @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount          Decimal               @map("total_amount") @db.Decimal(12, 2)
  currency             String                @default("INR") @db.Char(3)
  notes                String?
  policySnapshot       Json?                 @map("policy_snapshot")
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer             User                  @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict)
  mother               MotherProfile         @relation(fields: [motherId], references: [id], onDelete: Restrict)
  kitchen              Kitchen               @relation(fields: [kitchenId], references: [id], onDelete: Restrict)
  address              Address               @relation(fields: [addressId], references: [id], onDelete: Restrict)
  subscription         Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  payments             Payment[]
  delivery             Delivery?
  earnings             Earning[]
  ratings              Rating[]
  complaints           Complaint[]
  cancellationRequests CancellationRequest[]
  walletEntries        WalletLedgerEntry[]
  mealChangeRequests   MealChangeRequest[]
  ledgerEntries        PaymentLedgerEntry[]
  events               OrderEvent[]

  @@index([customerId, orderedAt(sort: Desc)])
  @@index([motherId, scheduledFor])
  @@index([kitchenId, scheduledFor])
  @@index([status, scheduledFor])
  @@map("orders")
  @@schema("paustik_marketplace")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderId         String  @map("order_id") @db.Uuid
  mealId          String  @map("meal_id") @db.Uuid
  mealName        String  @map("meal_name")
  quantity        Int
  unitPrice       Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal       Decimal @map("line_total") @db.Decimal(12, 2)
  dietarySnapshot Json?   @map("dietary_snapshot")
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  meal            Meal    @relation(fields: [mealId], references: [id], onDelete: Restrict)

  @@map("order_items")
  @@schema("paustik_marketplace")
}

model Payment {
  id                String               @id @default(uuid()) @db.Uuid
  orderId           String               @map("order_id") @db.Uuid
  provider          String               @default("mock")
  providerPaymentId String?              @unique @map("provider_payment_id")
  status            PaymentStatus        @default(PENDING)
  amount            Decimal              @db.Decimal(12, 2)
  currency          String               @default("INR") @db.Char(3)
  idempotencyKey    String?              @unique @map("idempotency_key")
  capturedAt        DateTime?            @map("captured_at") @db.Timestamptz(6)
  refundedAt        DateTime?            @map("refunded_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  order             Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ledgerEntries     PaymentLedgerEntry[]

  @@index([orderId, createdAt])
  @@map("payments")
  @@schema("paustik_marketplace")
}

model PaymentLedgerEntry {
  id        String          @id @default(uuid()) @db.Uuid
  paymentId String?         @map("payment_id") @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  category  PaymentCategory
  amount    Decimal         @db.Decimal(12, 2)
  currency  String          @default("INR") @db.Char(3)
  reference String?
  metadata  Json?
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  payment   Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, category, createdAt])
  @@map("payment_ledger_entries")
  @@schema("paustik_marketplace")
}

model WalletLedgerEntry {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  orderId        String?              @map("order_id") @db.Uuid
  subscriptionId String?              @map("subscription_id") @db.Uuid
  direction      WalletEntryDirection
  amount         Decimal              @db.Decimal(12, 2)
  currency       String               @default("INR") @db.Char(3)
  reference      String               @unique
  description    String
  metadata       Json?
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription   Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([orderId, createdAt])
  @@schema("paustik_marketplace")
}

model Delivery {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String                @unique @map("order_id") @db.Uuid
  agentId               String?               @map("agent_id") @db.Uuid
  status                DeliveryStatus        @default(ASSIGNED)
  assignedAt            DateTime?             @map("assigned_at") @db.Timestamptz(6)
  acceptedAt            DateTime?             @map("accepted_at") @db.Timestamptz(6)
  pickupAt              DateTime?             @map("pickup_at") @db.Timestamptz(6)
  deliveredAt           DateTime?             @map("delivered_at") @db.Timestamptz(6)
  failureReason         String?               @map("failure_reason")
  trackingReference     String?               @unique @map("tracking_reference")
  currentLatitude       Decimal?              @map("current_latitude") @db.Decimal(10, 7)
  currentLongitude      Decimal?              @map("current_longitude") @db.Decimal(10, 7)
  currentAccuracyMeters Decimal?              @map("current_accuracy_meters") @db.Decimal(7, 2)
  locationUpdatedAt     DateTime?             @map("location_updated_at") @db.Timestamptz(6)
  locationConsentAt     DateTime?             @map("location_consent_at") @db.Timestamptz(6)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Cascade)
  agent                 DeliveryAgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([agentId, status, assignedAt])
  @@index([status, assignedAt])
  @@map("deliveries")
  @@schema("paustik_marketplace")
}

model Earning {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @map("user_id") @db.Uuid
  orderId          String                @map("order_id") @db.Uuid
  motherId         String?               @map("mother_id") @db.Uuid
  agentId          String?               @map("agent_id") @db.Uuid
  beneficiaryRole  UserRole              @map("beneficiary_role")
  grossAmount      Decimal               @map("gross_amount") @db.Decimal(12, 2)
  commissionAmount Decimal               @default(0) @map("commission_amount") @db.Decimal(12, 2)
  netAmount        Decimal               @map("net_amount") @db.Decimal(12, 2)
  currency         String                @default("INR") @db.Char(3)
  status           LedgerStatus          @default(PENDING)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  availableAt      DateTime?             @map("available_at") @db.Timestamptz(6)
  paidAt           DateTime?             @map("paid_at") @db.Timestamptz(6)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  mother           MotherProfile?        @relation(fields: [motherId], references: [id], onDelete: SetNull)
  agent            DeliveryAgentProfile? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@unique([orderId, userId, beneficiaryRole])
  @@index([userId, status, createdAt])
  @@map("earnings")
  @@schema("paustik_marketplace")
}

model Payout {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @map("user_id") @db.Uuid
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @default("INR") @db.Char(3)
  status           PayoutStatus @default(PENDING)
  provider         String?
  providerPayoutId String?      @unique @map("provider_payout_id")
  idempotencyKey   String?      @unique @map("idempotency_key")
  failureReason    String?      @map("failure_reason")
  requestedAt      DateTime     @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(6)
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, status, requestedAt])
  @@map("payouts")
  @@schema("paustik_marketplace")
}

model CommissionSetting {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  motherBasisPoints   Int       @map("mother_basis_points")
  deliveryBasisPoints Int       @map("delivery_basis_points")
  platformBasisPoints Int       @map("platform_basis_points")
  effectiveFrom       DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime? @map("effective_to") @db.Timestamptz(6)
  isActive            Boolean   @default(false) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, effectiveFrom])
  @@map("commission_settings")
  @@schema("paustik_marketplace")
}

model MarketplacePolicy {
  id                      String     @id @default(uuid()) @db.Uuid
  name                    String
  cancellationCutoffHours Int?       @map("cancellation_cutoff_hours")
  mealChangeCutoffHours   Int?       @map("meal_change_cutoff_hours")
  cancellationRule        Json?      @map("cancellation_rule")
  mealChangeRule          Json?      @map("meal_change_rule")
  effectiveFrom           DateTime?  @map("effective_from") @db.Timestamptz(6)
  effectiveTo             DateTime?  @map("effective_to") @db.Timestamptz(6)
  isActive                Boolean    @default(false) @map("is_active")
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  mealPlans               MealPlan[]

  @@index([isActive, effectiveFrom])
  @@map("marketplace_policies")
  @@schema("paustik_marketplace")
}

model Rating {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  authorId      String   @map("author_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  mealId        String?  @map("meal_id") @db.Uuid
  mealScore     Int?     @map("meal_score")
  deliveryScore Int?     @map("delivery_score")
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author        User     @relation("RatingsGiven", fields: [authorId], references: [id], onDelete: Restrict)
  subject       User     @relation("RatingsReceived", fields: [subjectId], references: [id], onDelete: Restrict)
  meal          Meal?    @relation(fields: [mealId], references: [id], onDelete: SetNull)

  @@unique([orderId, authorId, subjectId])
  @@index([subjectId, createdAt(sort: Desc)])
  @@map("ratings")
  @@schema("paustik_marketplace")
}

model Complaint {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String?         @map("order_id") @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  category    String
  description String
  status      ComplaintStatus @default(OPEN)
  resolution  String?
  resolvedAt  DateTime?       @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  order       Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("complaints")
  @@schema("paustik_marketplace")
}

model CancellationRequest {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  orderId        String?       @map("order_id") @db.Uuid
  reason         String?
  status         RequestStatus @default(PENDING)
  refundAmount   Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  ruleSnapshot   Json?         @map("rule_snapshot")
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@map("cancellation_requests")
  @@schema("paustik_marketplace")
}

model MealChangeRequest {
  id           String        @id @default(uuid()) @db.Uuid
  orderId      String        @map("order_id") @db.Uuid
  requesterId  String        @map("requester_id") @db.Uuid
  fromMealId   String        @map("from_meal_id") @db.Uuid
  toMealId     String        @map("to_meal_id") @db.Uuid
  status       RequestStatus @default(PENDING)
  ruleSnapshot Json?         @map("rule_snapshot")
  decidedAt    DateTime?     @map("decided_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requester    User          @relation(fields: [requesterId], references: [id], onDelete: Restrict)
  fromMeal     Meal          @relation("MealChangeFrom", fields: [fromMealId], references: [id], onDelete: Restrict)
  toMeal       Meal          @relation("MealChangeTo", fields: [toMealId], references: [id], onDelete: Restrict)

  @@index([orderId, status, createdAt])
  @@map("meal_change_requests")
  @@schema("paustik_marketplace")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  kind      String
  entityId  String?   @map("entity_id") @db.Uuid
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("paustik_marketplace")
}

model QualityCheck {
  id               String             @id @default(uuid()) @db.Uuid
  motherId         String             @map("mother_id") @db.Uuid
  kitchenId        String             @map("kitchen_id") @db.Uuid
  inspectorUserId  String?            @map("inspector_user_id") @db.Uuid
  status           QualityCheckStatus
  score            Decimal?           @db.Decimal(5, 2)
  notes            String?
  correctiveAction String?            @map("corrective_action")
  inspectedAt      DateTime           @default(now()) @map("inspected_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  mother           MotherProfile      @relation(fields: [motherId], references: [id], onDelete: Cascade)
  kitchen          Kitchen            @relation(fields: [kitchenId], references: [id], onDelete: Cascade)
  inspector        User?              @relation("QualityInspector", fields: [inspectorUserId], references: [id], onDelete: SetNull)

  @@index([kitchenId, inspectedAt(sort: Desc)])
  @@map("quality_checks")
  @@schema("paustik_marketplace")
}

model AdminActivityLog {
  id            String   @id @default(uuid()) @db.Uuid
  adminId       String   @map("admin_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id") @db.Uuid
  previousValue Json?    @map("previous_value")
  newValue      Json?    @map("new_value")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin         User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([adminId, createdAt(sort: Desc)])
  @@map("admin_activity_logs")
  @@schema("paustik_marketplace")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("paustik_marketplace")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
  @@schema("paustik_marketplace")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
  @@schema("paustik_marketplace")
}

model FailedLoginAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  identifierHash String   @map("identifier_hash") @db.Char(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([identifierHash, createdAt])
  @@map("failed_login_attempts")
  @@schema("paustik_marketplace")
}

model OrderEvent {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  actorUserId String?     @map("actor_user_id") @db.Uuid
  status      OrderStatus
  detail      String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorUser   User?       @relation("OrderEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_events")
  @@schema("paustik_marketplace")
}
