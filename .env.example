# Leave empty for the local-only SQLite sign-in demo. Hosted environments need Neon/PostgreSQL.
DATABASE_URL=
# Optional direct Neon URL, used by Prisma migration commands when available.
DIRECT_URL=
# Optional, development-only path for isolating the local SQLite sign-in database.
PAUSTIK_LOCAL_AUTH_DB_NAME=

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# One-time first-admin bootstrap only. Username defaults to Asish11; set these in the shell running `pnpm db:admin:create`.
PAUSTIK_ADMIN_USERNAME=
PAUSTIK_ADMIN_PASSWORD=
PAUSTIK_ADMIN_EMAIL=
PAUSTIK_ADMIN_NAME=

# Temporary preview sign-in; displayed phone codes do not verify phone ownership.
PAUSTIK_DEMO_AUTH=false

# Twilio Verify SMS/WhatsApp OTP. Create an API key and a Verify Service in Twilio Console.
# Keep all three values server-side; never use NEXT_PUBLIC_ on these variables.
# WhatsApp additionally requires a configured, approved WhatsApp sender on the Verify Service.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Resend transactional email for account confirmation in production.
# Verify the sender domain in Resend before using EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
PAUSTIK_PUBLIC_URL=http://localhost:3000

# Existing tracking service settings; keep these server-side only.
PAUSTIK_ADMIN_TOKEN=
CRON_SECRET=
